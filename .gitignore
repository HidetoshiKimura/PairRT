# uv が作る Python 環境(いつでも作り直せる)
.venv/

# Python / pytest のキャッシュ
__pycache__/
*.pyc
.pytest_cache/

# ビルド成果物
build/
dist/
*.egg-info/

# pairrt の出力(データ由来のファイルは記録しない)
*_rtcurated.tsv
*_rt_excluded.tsv

# 設計書と実装計画(研究データの情報を含むので公開しない。手元にだけ置く)
docs/

# 認証情報などを置く環境変数ファイル(念のため)
.env
.env.*

# OneDrive / Windows が作るファイル
desktop.ini
Thumbs.db
